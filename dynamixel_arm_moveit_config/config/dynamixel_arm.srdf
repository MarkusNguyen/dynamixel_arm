<?xml version="1.0" encoding="UTF-8"?>
<robot name="dynamixel_arm">
    <!-- GROUPS: Switched 'arm' to use a explicit <chain> for Cartesian Planning -->
    <group name="arm">
        <chain base_link="base_link" tip_link="end_effector"/>
    </group>
    
    <group name="gripper">
        <joint name="gripper"/>
    </group>

    <group name="end_effector">
        <joint name="end_effector_frame"/>
    </group>

    <!-- END EFFECTOR DEFINITION -->
    <end_effector name="end_effector" parent_link="end_effector" group="end_effector" parent_group="arm"/>

    <!-- VIRTUAL JOINT -->
    <virtual_joint name="base_link" type="fixed" parent_frame="world" child_link="base_link"/>

    <!-- PASSIVE JOINTS -->
    <passive_joint name="outlink2"/>
    <passive_joint name="outlink2_upper"/>
    <passive_joint name="inlink1"/>
    <passive_joint name="inlink2"/>
    <passive_joint name="outlink1"/>
    <passive_joint name="outlink1_upper"/>

    <!-- DISABLE COLLISIONS -->
    <!-- Added exemptions for the new 'end_effector' link frame -->
    <disable_collisions link1="end_effector" link2="link_5_1" reason="Adjacent"/>
    <disable_collisions link1="end_effector" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="fin_1_1" reason="Never"/>
    <disable_collisions link1="end_effector" link2="fin_2_1" reason="Never"/>

    <!-- Existing collision exclusions -->
    <disable_collisions link1="base_link" link2="link_1_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link_2_1" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_3_1" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="fin_2_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="link_2_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="link_3_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="link_5_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="linkin_2_1" reason="Default"/>
    <disable_collisions link1="fin_1_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="fin_1_1" link2="linkout_2_1" reason="Adjacent"/>
    <disable_collisions link1="fin_2_1" link2="link_2_1" reason="Never"/>
    <disable_collisions link1="fin_2_1" link2="link_3_1" reason="Never"/>
    <disable_collisions link1="fin_2_1" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="fin_2_1" link2="link_5_1" reason="Never"/>
    <disable_collisions link1="fin_2_1" link2="linkin_1_1" reason="Default"/>
    <disable_collisions link1="fin_2_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="fin_2_1" link2="linkout_1_1" reason="Adjacent"/>
    <disable_collisions link1="fin_2_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="link_2_1" reason="Adjacent"/>
    <disable_collisions link1="link_1_1" link2="link_3_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="link_5_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="link_1_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="link_3_1" reason="Adjacent"/>
    <disable_collisions link1="link_2_1" link2="link_4_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="link_5_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="link_2_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="link_3_1" link2="link_4_1" reason="Adjacent"/>
    <disable_collisions link1="link_3_1" link2="link_5_1" reason="Never"/>
    <disable_collisions link1="link_3_1" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="link_3_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="link_3_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="link_3_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="link_4_1" link2="link_5_1" reason="Adjacent"/>
    <disable_collisions link1="link_4_1" link2="linkin_1_1" reason="Never"/>
    <disable_collisions link1="link_4_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="link_4_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="link_4_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="link_5_1" link2="linkin_1_1" reason="Adjacent"/>
    <disable_collisions link1="link_5_1" link2="linkin_2_1" reason="Adjacent"/>
    <disable_collisions link1="link_5_1" link2="linkout_1_1" reason="Adjacent"/>
    <disable_collisions link1="link_5_1" link2="linkout_2_1" reason="Adjacent"/>
    <disable_collisions link1="linkin_1_1" link2="linkin_2_1" reason="Never"/>
    <disable_collisions link1="linkin_1_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="linkin_1_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="linkin_2_1" link2="linkout_1_1" reason="Never"/>
    <disable_collisions link1="linkin_2_1" link2="linkout_2_1" reason="Never"/>
    <disable_collisions link1="linkout_1_1" link2="linkout_2_1" reason="Never"/>
</robot>