  <ros2_control name="DynamixelArmHardwareInterface" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find dynamixel_arm_description)/mjcf/scene.xml</param>
    </hardware>
    <joint name="joint1">
